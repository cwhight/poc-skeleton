# Base URL of the Go (Cloud Run) API. Set per-slug via Terraform/Vercel env.
# Leave empty to call the same origin (e.g. behind a Vercel rewrite/proxy).
NEXT_PUBLIC_API_BASE=

# Optional: forward funnel beacons (/api/event) to an analytics backend.
# When unset, /api/event just acks 204 and relies on the platform-native sink.
ANALYTICS_FORWARD_URL=
